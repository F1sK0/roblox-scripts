local pages = {}
local tabs = {}
local currentSettings = {}

local function publish(key, value)
    currentSettings[key] = value
end

local function setting(key, default)
    if currentSettings[key] == nil then
        currentSettings[key] = default
    end
    return currentSettings[key]
end

function newPage(name)
    local page = Instance.new("ScrollingFrame")
    page.Name = name .. "Page"
    page.Size = UDim2.new(1, -10, 1, -10)
    page.Position = UDim2.new(0, 5, 0, 5)
    page.BackgroundColor3 = panelBg
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 3
    page.Visible = false
    page.Parent = container

    local pageLayout = Instance.new("UIListLayout")
    pageLayout.Padding = UDim.new(0, 8)
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Parent = page

    pages[name] = page
    return page
end

function addTab(id, text)
    local tabButton = Instance.new("TextButton")
    tabButton.Name = id .. "Tab"
    tabButton.Size = UDim2.new(1, -10, 0, 35)
    tabButton.BackgroundColor3 = darkBg
    tabButton.TextColor3 = gray
    tabButton.Text = text
    tabButton.Font = Enum.Font.GothamSemibold
    tabButton.TextSize = 13
    tabButton.BorderSizePixel = 0
    tabButton.Parent = tabFrame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 5)
    btnCorner.Parent = tabButton

    tabButton.MouseButton1Click:Connect(function()
        switchPage(id)
    end)
    
    tabs[id] = tabButton
end

function switchPage(name)
    for k, v in pairs(pages) do
        v.Visible = false
    end
    for k, v in pairs(tabs) do
        v.TextColor3 = gray
        v.BackgroundColor3 = darkBg
    end
    if pages[name] then
        pages[name].Visible = true
    end
    if tabs[name] then
        tabs[name].TextColor3 = white
        tabs[name].BackgroundColor3 = purple
    end
end

function section(parent, titleText)
