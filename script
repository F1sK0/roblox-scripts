local function newPage(name) return Instance.new("Frame") end
local function addTab(id, text) end
local function section(parent, title) end
local function toggle(parent, text, key) end
local function make(className, properties, parent) 
    local obj = Instance.new(className)
    for k, v in pairs(properties) do obj[k] = v end
    if parent then obj.Parent = parent end
    return obj
end
local function publish(key, value) end
local function setting(key, default) return default end
local function switchPage(name) end
